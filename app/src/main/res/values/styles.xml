<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="RowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <!-- Figma 1216:3535: 15 Medium · 행간 20 · 자간 -0.2 -->
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">-0.013</item>
    </style>
    <style name="RowSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/muted</item>
        <!-- 13 Regular · 행간 18 · 자간 -0.2 -->
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="RowSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- 디자인 토글: 보라 트랙 + 흰 원 -->
        <item name="useMaterialThemeColors">false</item>
        <item name="android:thumb">@drawable/switch_thumb_shape</item>
        <item name="track">@drawable/switch_track_shape</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="switchMinWidth">44dp</item>
        <!-- 머티리얼 기본 최소 높이 48dp를 없애 행 높이를 Figma(제목+요약 64 · 제목만 50)에 맞춤 -->
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@null</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:background">@color/line</item>
    </style>
    <style name="Category">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">6dp</item>
        <!-- 14 Bold · 행간 20 · 자간 -0.2 -->
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">-0.014</item>
        <item name="android:text">카테고리</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>
    <style name="RowTextTap" parent="RowText">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <!-- 탭 영역은 위아래로 6dp 넓히되 행 높이는 그대로(음수 여백으로 상쇄) -->
        <item name="android:paddingVertical">6dp</item>
        <item name="android:layout_marginVertical">-6dp</item>
    </style>
    <style name="AppBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
