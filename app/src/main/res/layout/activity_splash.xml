<?xml version="1.0" encoding="utf-8"?>
<!-- S-01 스플래시 (Figma 1216:3004): 보라 그라데이션 · "자유를 얻은 에어팟!" · AOS PODS 로고 · 하단 be:free © vividRed -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/splash_bg"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="80dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자유를 얻은 에어팟!"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:letterSpacing="-0.02"
            android:fontFamily="@font/pretendard_medium"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/logo_splash"
            android:contentDescription="AOS PODS"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="10dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_befree"
            android:contentDescription="be:free"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="© vividRed"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:letterSpacing="-0.02"/>
    </LinearLayout>
</LinearLayout>
