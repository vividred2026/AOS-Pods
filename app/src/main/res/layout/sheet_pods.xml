<?xml version="1.0" encoding="utf-8"?>
<!-- 시스템 오버레이 배터리 팝업 (Figma 1216:5587, bottomsheetHeader): 손잡이 50×4 · 이름 18 Bold + 모델 14 회색 · ✕ · 왼쪽/오른쪽/케이스 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg">

    <View
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/sheet_handle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">
        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AirPods"
            android:textColor="@color/grey900"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold"/>
        <TextView
            android:id="@+id/sheetModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <ImageView
            android:id="@+id/sheetClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">
        <include layout="@layout/pod_item" android:id="@+id/sheetLeft"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <include layout="@layout/pod_item" android:id="@+id/sheetRight"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <include layout="@layout/pod_item" android:id="@+id/sheetCase"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
