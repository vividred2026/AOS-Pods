<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- 앱 바: AOS PODS 로고 (Figma 메인 AppBar · px16 py10) -->
        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="106dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/logo_bar"
            android:contentDescription="AOS PODS"/>

        <!-- 권한이 빠졌을 때만: 연결 카드와 같은 회색 카드 + [허용] → S-02 접근 권한 안내 -->
        <LinearLayout
            android:id="@+id/permCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/pair_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="권한이 필요해요"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:fontFamily="@font/pretendard_bold"
                    android:letterSpacing="-0.019"/>
                <TextView
                    android:id="@+id/permMissing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/btnPermFix"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_pair"
                android:gravity="center"
                android:text="허용"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_semibold"/>
        </LinearLayout>

        <!-- 설정 리스트 (M-00) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:paddingBottom="8dp">

            <!-- 에어팟 연결 카드 (Figma M-00 · 1215:2013 연결 전 / 1215:1992 연결 후) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- 연결 전: 안내 + [연결] -->
                <LinearLayout
                    android:id="@+id/pairDisconnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/pair_card_bg"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="에어팟 자유 쟁취"
                            android:textColor="@color/ink"
                            android:textSize="16sp"
                            android:fontFamily="@font/pretendard_bold"
                            app:lineHeight="24sp"
                            android:letterSpacing="-0.019"/>
                        <TextView
                            android:id="@+id/pairStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="연결 안 됨 | 버튼을 눌러 에어팟과 페어링"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            app:lineHeight="18sp"
                            android:letterSpacing="-0.015"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/btnPair"
                        android:layout_width="64dp"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_pair"
                        android:gravity="center"
                        android:text="연결"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold"/>
                </LinearLayout>

                <!-- 연결 후: 이름 - 모델 번호 · R/L/C 배터리 (탭: 에어팟 정보 / 길게: 다시 연결) -->
                <LinearLayout
                    android:id="@+id/pairConnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/pair_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="자유를 얻은 에어팟"
                            android:textColor="@color/ink"
                            android:textSize="16sp"
                            android:fontFamily="@font/pretendard_bold"
                            app:lineHeight="24sp"
                            android:letterSpacing="-0.019"/>
                        <TextView
                            android:id="@+id/pairName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/muted"
                            android:textSize="14sp"
                            android:fontFamily="@font/pretendard_bold"
                            android:letterSpacing="-0.014"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/podsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <include android:id="@+id/podR" layout="@layout/pair_pod"/>
                        <include android:id="@+id/podL" layout="@layout/pair_pod"/>
                        <include android:id="@+id/podC" layout="@layout/pair_pod"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/pairDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </FrameLayout>

            <!-- 서비스 활성화 -->
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="서비스 활성화"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swService" style="@style/RowSwitch"/>
            </LinearLayout>

            <!-- 모델 -->
            <LinearLayout android:id="@+id/rowModel" style="@style/Row"
                android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="모델"/>
                    <TextView android:id="@+id/modelValue" style="@style/RowSub" android:text="에어팟 4"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
            </LinearLayout>

            <!-- 배터리 표시 -->
            <TextView style="@style/Category" android:text="배터리 표시"/>

            <LinearLayout style="@style/Row">
                <LinearLayout android:id="@+id/textNotif" style="@style/RowTextTap">
                    <TextView style="@style/RowTitle" android:text="알림으로 표시"/>
                    <TextView style="@style/RowSub" android:text="탭하면 알림 설정 · 스위치로 ON/OFF"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNotif" style="@style/RowSwitch"/>
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <LinearLayout android:id="@+id/textPercent" style="@style/RowTextTap">
                    <TextView style="@style/RowTitle" android:text="알림 아이콘에 퍼센트 표시"/>
                    <TextView style="@style/RowSub" android:text="탭하면 아이콘 퍼센트 설정"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPercent" style="@style/RowSwitch"/>
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <LinearLayout android:id="@+id/textPopup" style="@style/RowTextTap">
                    <TextView style="@style/RowTitle" android:text="팝업 창으로 표시"/>
                    <TextView style="@style/RowSub" android:text="탭하면 팝업 설정 · 스위치로 ON/OFF"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPopup" style="@style/RowSwitch"/>
            </LinearLayout>

            <!-- 청취 모드 (AACP 연결 성공 시에만 표시) -->
            <LinearLayout
                android:id="@+id/listenSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/Category" android:text="청취 모드"/>
                <LinearLayout android:id="@+id/rowListen" style="@style/Row"
                    android:clickable="true" android:focusable="true">
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="청취 모드"/>
                        <TextView android:id="@+id/listenValue" style="@style/RowSub" android:text="확인 중"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 착용 감지 (STEP 3 · 오디오 포커스) -->
            <TextView style="@style/Category" android:text="착용 감지"/>
            <TextView
                android:id="@+id/wearStatus"
                style="@style/RowSub"
                android:layout_width="match_parent"
                android:paddingHorizontal="16dp"
                android:text="서비스를 켜면 착용 신호를 확인해요"/>

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="일시정지"/>
                    <TextView style="@style/RowSub" android:text="AirPods를 빼면 재생 일시정지"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPause" style="@style/RowSwitch"/>
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="다시 재생"/>
                    <TextView style="@style/RowSub" android:text="AirPods를 다시 끼면 재생 재개"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swResume" style="@style/RowSwitch"/>
            </LinearLayout>

            <!-- 정보 -->
            <TextView style="@style/Category" android:text="정보"/>

            <LinearLayout android:id="@+id/rowNight" style="@style/Row"
                android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="다크 모드"/>
                    <TextView android:id="@+id/nightValue" style="@style/RowSub" android:text="시스템 기본값"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDiag" style="@style/Row"
                android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="진단 정보"/>
                    <TextView style="@style/RowSub" android:text="마지막 에어팟 신호 원문 · 해석값 확인/복사"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowPrivacy" style="@style/Row"
                android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="개인정보처리방침"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/footerVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="AosPods · 미니멀 버전"
            android:textColor="@color/muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
