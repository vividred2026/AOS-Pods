<?xml version="1.0" encoding="utf-8"?>
<!-- 팝업 배터리 한 칸 (Figma WF/PopupPod 1230:3095): 보라 칩 56(모서리 16) + 이어버드 사진 28×46 / 케이스 "C" 40 Bold
     · 라벨 12 · 퍼센트 16 Bold · 막대 56×6 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="4dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/pod_chip">
        <ImageView
            android:id="@+id/podIcon"
            android:layout_width="28dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/bud_left"
            android:contentDescription="@null"/>
        <TextView
            android:id="@+id/podLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="C"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/pretendard_bold"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/podLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="왼쪽"
        android:textColor="@color/sub"
        android:textSize="12sp"
        android:lineHeight="18sp"/>
    <TextView
        android:id="@+id/podPct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:lineHeight="24sp"
        android:fontFamily="@font/pretendard_bold"/>
    <ProgressBar
        android:id="@+id/podBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="56dp"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/pod_progress"/>
</LinearLayout>
