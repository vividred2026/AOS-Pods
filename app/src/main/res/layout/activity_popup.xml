<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <include android:id="@+id/appbar" layout="@layout/appbar"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingVertical="8dp" android:paddingHorizontal="4dp">
                <LinearLayout android:id="@+id/rowTitle" style="@style/Row"
                    android:clickable="true" android:focusable="true">
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="제목 문구"/>
                        <TextView android:id="@+id/titleValue" style="@style/RowSub" android:text="비우면 기기 이름을 표시"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
                </LinearLayout>
                <View style="@style/Divider"/>
                <include layout="@layout/seek_row" android:id="@+id/seekSize"/>
                <include layout="@layout/seek_row" android:id="@+id/seekCorner"/>
                <include layout="@layout/seek_row" android:id="@+id/seekMargin"/>
                <include layout="@layout/seek_row" android:id="@+id/seekDim"/>
                <View style="@style/Divider"/>
                <LinearLayout style="@style/Row">
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="팝업 숨기기"/>
                        <TextView style="@style/RowSub" android:text="양쪽 AirPods를 모두 착용하면"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swHide" style="@style/RowSwitch"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
